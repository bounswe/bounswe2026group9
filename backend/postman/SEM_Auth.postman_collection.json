{
  "info": {
    "name": "SEM Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8888"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "verification_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth", "register"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"12345678\",\n  \"date_of_birth\": \"2000-01-15\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  var json = pm.response.json();",
              "  pm.collectionVariables.set('access_token', json.access_token);",
              "  pm.test('Register successful', function() {",
              "    pm.expect(json.user.username).to.eql('testuser');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"12345678\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  var json = pm.response.json();",
              "  pm.collectionVariables.set('access_token', json.access_token);",
              "  pm.test('Login successful', function() {",
              "    pm.expect(json.user.email).to.eql('test@example.com');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Me",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/auth/me",
          "host": ["{{base_url}}"],
          "path": ["auth", "me"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Me returns user', function() {",
              "  var json = pm.response.json();",
              "  pm.expect(json.username).to.eql('testuser');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Refresh",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/auth/refresh",
          "host": ["{{base_url}}"],
          "path": ["auth", "refresh"]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  var json = pm.response.json();",
              "  pm.collectionVariables.set('access_token', json.access_token);",
              "  pm.test('Refresh successful', function() {",
              "    pm.expect(json.access_token).to.be.a('string');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/auth/logout",
          "host": ["{{base_url}}"],
          "path": ["auth", "logout"]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logout successful', function() {",
              "  var json = pm.response.json();",
              "  pm.expect(json.message).to.eql('Logged out successfully');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Verify Email",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/auth/verify-email?token={{verification_token}}",
          "host": ["{{base_url}}"],
          "path": ["auth", "verify-email"],
          "query": [
            { "key": "token", "value": "{{verification_token}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Email verified', function() {",
              "  var json = pm.response.json();",
              "  pm.expect(json.message).to.eql('Email verified successfully');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Resend Verification",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/auth/resend-verification",
          "host": ["{{base_url}}"],
          "path": ["auth", "resend-verification"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Resend returns message', function() {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Google OAuth - Get Auth URL",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/auth/google?mode=login",
          "host": ["{{base_url}}"],
          "path": ["auth", "google"],
          "query": [
            { "key": "mode", "value": "login" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns Google auth URL', function() {",
              "  var json = pm.response.json();",
              "  pm.expect(json.auth_url).to.include('accounts.google.com');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Login - Wrong Password (lockout test)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"wrongpassword\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Wrong password returns 401', function() {",
              "  pm.expect(pm.response.code).to.eql(401);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
