# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=replace-with-service-role-key

# JWT
JWT_SECRET=replace-with-32-byte-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://thesocialeventmapper.social/auth/google/callback

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Social Event Mapper

# App
ENVIRONMENT=production
FRONTEND_URL=https://thesocialeventmapper.social
BACKEND_URL=https://thesocialeventmapper.social
CORS_ORIGINS=https://thesocialeventmapper.social
