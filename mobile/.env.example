# Mobile app does not use a runtime .env file.
# The API base URL is compiled into the app via RetrofitProvider.kt:
#
#   mobile/app/src/main/java/com/bounswe/group9/mobile/data/remote/RetrofitProvider.kt
#
# Production (default):
#   BASE_URL = "https://api.thesocialeventmapper.social/"
#
# Android emulator pointing at a local backend:
#   BASE_URL = "http://10.0.2.2:8888/"
#
# Physical device on the same LAN as the backend machine:
#   BASE_URL = "http://<YOUR_COMPUTER_LAN_IP>:8888/"
#
# After editing RetrofitProvider.kt, rebuild the app:
#   ./gradlew assembleDebug
